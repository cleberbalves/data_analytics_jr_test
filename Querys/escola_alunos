CREATE TABLE escolas_alunos AS
SELECT 
    e.CODESC AS codigo_escola,
    e.NOMES AS nome_escola,
    e.DRE AS diretoria_regional,
    ed.CODESC AS codigo_escola_educando,
    ed.SERIEV AS serie_ano,
    ed.SEXO AS sexo_aluno,
    ed.IDADE AS idade_aluno,
    ed.RACA AS raca_aluno,
    ed.NEE AS necessidade_especial,
    SUM(ed.QTDE) AS quantidade_alunos  -- Soma a quantidade de alunos por categoria
FROM 
    escolas e
JOIN 
    educandos ed
ON 
    e.CODESC = ed.CODESC
GROUP BY 
    e.CODESC, e.NOMES, e.DRE, ed.CODESC, ed.SERIEV, ed.SEXO, ed.IDADE, ed.RACA, ed.NEE;